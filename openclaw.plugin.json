{
  "id": "trustedrouter",
  "name": "TrustedRouter",
  "description": "TrustedRouter model provider (OpenAI-compatible)",
  "categories": ["models"],
  "activation": { "onStartup": false },
  "enabledByDefault": true,
  "providers": ["trustedrouter"],
  "providerEndpoints": [
    { "endpointClass": "trustedrouter", "hosts": ["api.trustedrouter.com"] }
  ],
  "providerRequest": { "providers": { "trustedrouter": { "family": "trustedrouter" } } },
  "setup": {
    "providers": [{ "id": "trustedrouter", "envVars": ["TRUSTEDROUTER_API_KEY"] }]
  },
  "providerAuthChoices": [
    {
      "provider": "trustedrouter",
      "method": "api-key",
      "choiceId": "trustedrouter-api-key",
      "choiceLabel": "TrustedRouter API key",
      "groupId": "trustedrouter",
      "groupLabel": "TrustedRouter",
      "groupHint": "API key",
      "optionKey": "trustedrouterApiKey",
      "cliFlag": "--trustedrouter-api-key",
      "cliOption": "--trustedrouter-api-key <key>",
      "cliDescription": "TrustedRouter API key"
    }
  ],
  "modelCatalog": {
    "modelsDev": { "trustedrouter": "trustedrouter" },
    "providers": {
      "trustedrouter": {
        "baseUrl": "https://api.trustedrouter.com/v1",
        "api": "openai-completions",
        "defaultModel": "trustedrouter/auto",
        "models": [
          {
